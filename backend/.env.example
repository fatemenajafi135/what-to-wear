# --- LLM gateway (Vercel AI Gateway) -----------------------------------------
# All model + embedding calls route through this one endpoint. Nothing in the
# codebase calls a provider SDK directly.
AI_GATEWAY_API_KEY=your-vercel-ai-gateway-key
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1

# Model IDs are provider-qualified for the gateway.
WTW_CHAT_MODEL=openai/gpt-5.4-mini
WTW_EMBEDDING_MODEL=openai/text-embedding-3-small
WTW_JUDGE_MODEL=openai/gpt-5.4-mini
WTW_EMBEDDING_DIMS=1536

# --- external APIs -----------------------------------------------------------
TAVILY_API_KEY=your-tavily-key
COHERE_API_KEY=your-cohere-key
WTW_RERANK_MODEL=rerank-v4.0-fast
# Open-Meteo needs no key.

# --- vectorstore (optional) ---------------------------------------------------
# Default: connects to a Qdrant SERVER at this URL so repeated runs / multiple
# notebook kernels all reconnect to the same embedded corpus instead of each
# re-embedding it (and, unlike local on-disk mode, supports several processes
# at once — no "already locked" errors). Two ways to get a server, pick one:
#   - local Docker (kept around from earlier, currently stopped):
#       docker run -d --name whattowear-qdrant -p 6333:6333 -p 6334:6334 \
#         -v ./artifacts/qdrant_server_storage:/qdrant/storage qdrant/qdrant
#     -> WTW_QDRANT_URL=http://localhost:6333, leave WTW_QDRANT_API_KEY unset
#   - Qdrant Cloud free tier (cloud.qdrant.io): create a cluster, paste its
#     URL + API key below
WTW_QDRANT_URL=http://localhost:6333
# WTW_QDRANT_API_KEY=your-qdrant-cloud-api-key
# Set WTW_QDRANT_URL="" to force in-memory instead (fresh corpus every
# process, no persistence) — useful for CI/deterministic tests.

# --- tracing (REQUIRED, not optional) ----------------------------------------
# Every LLM/embedding/rerank call is required to be traced. config.py fails
# fast if LANGSMITH_API_KEY is missing.
LANGSMITH_API_KEY=your-langsmith-key
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=whattowear-rag

# --- database + auth (NEW in Feature 001: closet persistence) -----------------
# Supabase Postgres — transaction pooler, port 6543.
DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@<host>:6543/postgres
# Optional: direct connection, port 5432. Escape hatch for running Alembic
# migrations off the pooler (see specs/001-closet-persistence/research.md).
# DATABASE_URL_DIRECT=postgresql+psycopg://postgres.<ref>:<password>@<host>:5432/postgres

# https://<project-ref>.supabase.co — used to build the JWKS URL for local
# ES256 JWT verification (recommended path). No anon/service key needed.
SUPABASE_URL=https://<project-ref>.supabase.co
# JWT audience — defaults to "authenticated"; only set to override.
# SUPABASE_JWT_AUD=authenticated
# HS256 fallback ONLY — leave unset when using the recommended ES256/JWKS path.
# SUPABASE_JWT_SECRET=your-legacy-hs256-jwt-secret

# --- CORS (NEW in Feature 003: mvp-app) ---------------------------------------
# Comma-separated list of allowed browser origins. Defaults to "*" for local
# dev; set to the deployed Vercel origin(s) in production.
WTW_CORS_ORIGINS=*

# --- vision extraction + storage (NEW in Feature 003: mvp-app) ----------------
# Optional override — defaults to WTW_CHAT_MODEL (already multimodal).
# WTW_VISION_MODEL=openai/gpt-5.4-mini
# Supabase Storage bucket for uploaded wardrobe photos (created once via the
# Supabase dashboard, see specs/003-mvp-app/quickstart.md).
WTW_WARDROBE_PHOTOS_BUCKET=wardrobe-photos

# --- cache (NEW in Feature 005: production-hardening) -------------------------
# Per-user /suggest result cache (see specs/005-production-hardening). Railway's
# Redis addon connection string in production; local dev:
#   docker run -d -p 6379:6379 redis:7-alpine
# If unreachable, the cache degrades to "always miss, process fresh" — never
# fails the request.
REDIS_URL=redis://localhost:6379/0
