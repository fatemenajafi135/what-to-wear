# --- database ---------------------------------------------------------------
# Local pooler, port 54329 — NOT the "DB URL" `supabase start` prints, which
# is the direct port (54322). The local Supavisor pooler's tenant is fixed to
# "pooler-dev", so the username must be "postgres.pooler-dev", not "postgres"
# — confirmed by connecting through it; see specs/002-backend-foundation/
# research.md §2-3 for why the pooler is used even locally, and its "Local
# pooler tenant identifier" correction note for how this was found.
DATABASE_URL=postgresql://postgres.pooler-dev:postgres@127.0.0.1:54329/postgres
# Direct (session-mode, port 5432) connection, preferred by LangGraph's
# PostgresSaver checkpointer (memory/store.py) over the transaction-mode
# pooler above. Optional — falls back to DATABASE_URL if unset.
DATABASE_URL_DIRECT=

# --- app ----------------------------------------------------------------------
# One of the standard logging levels: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO
# Free-form; used only for log context. Not read for behavioral branching.
ENVIRONMENT=development

# --- auth (feature 003) ------------------------------------------------------
# Local API URL — matches `npx supabase status`'s "API URL". JWKS is served at
# {SUPABASE_URL}/auth/v1/.well-known/jwks.json (see specs/003-auth/research.md
# §2 for why signature verification goes through JWKS/ES256 rather than a
# shared HS256 secret).
SUPABASE_URL=http://127.0.0.1:54321
# The audience claim Supabase issues on every access token. Not project-specific.
SUPABASE_JWT_AUD=authenticated

# --- AI layer (feature 007) ---------------------------------------------------
# LLM gateway (Vercel AI Gateway) — every LLM and embedding call goes through this.
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
# Legacy fallback for the gateway key if AI_GATEWAY_API_KEY is unset — carried
# forward unchanged from the prototype, not this port's concern to remove.
VERCEL_OIDC_TOKEN=

# Model IDs are provider-qualified for the gateway.
WTW_CHAT_MODEL=openai/gpt-5.4-mini
WTW_EMBEDDING_MODEL=openai/text-embedding-3-small
WTW_JUDGE_MODEL=openai/gpt-5.4-mini
# Vision model for vision.py — defaults to WTW_CHAT_MODEL if unset.
WTW_VISION_MODEL=
WTW_EMBEDDING_DIMS=1536

# Cohere rerank — L3 only, retrieval/advanced.py.
COHERE_API_KEY=
WTW_RERANK_MODEL=rerank-v4.0-fast

# Tavily — live trend search, external/trends.py.
TAVILY_API_KEY=

# LangSmith tracing — required by the constitution on every LLM and retrieval call.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=whattowear-rag

# Qdrant — local container (see infra/docker-compose.yml / quickstart.md). No auth
# needed locally, so this is left unset; a production cloud instance would set it.
WTW_QDRANT_URL=http://localhost:6333
WTW_QDRANT_API_KEY=
WTW_QDRANT_TIMEOUT=120
WTW_QDRANT_BATCH_SIZE=32

# Local working copy of the corpus, outside the repo. Read by the ingestion CLI
# only — no absolute paths or `~` anywhere in code (constitution X). Relative to
# backend/ (where commands in this project are run from) — adjust if your
# checkout of the corpus lives somewhere else.
CORPUS_LOCAL_DIR=../../w2w-corpus
WTW_CHUNK_SIZE=900
WTW_CHUNK_OVERLAP=120

# LangGraph checkpointer connection pool max size (memory/store.py).
WTW_CHECKPOINTER_POOL_MAX=5
