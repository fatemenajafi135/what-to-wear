# Supabase Auth JS client (email/password sign-up/sign-in) -- issues the
# same Supabase JWT the backend already verifies (ES256/JWKS).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# The backend API (FastAPI). Local dev: http://localhost:8000
# Deployed: your Railway backend URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Only used by `npm run fetch:openapi` (dev-time, not read by the app itself).
API_BASE_URL=http://localhost:8000
