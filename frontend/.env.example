# --- auth (feature 003) ------------------------------------------------------
# Both values come from `npx supabase status` (run in infra/) once local
# Supabase is running — "API URL" and "anon key". Never put a real project's
# values here; this file is committed.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- backend API (feature 004) ------------------------------------------------
# The FastAPI backend (`cd backend && uv run uvicorn whattowear.main:app --reload`).
NEXT_PUBLIC_API_URL=http://localhost:8000
