# --- Local scratch (never commit) ---
notes/
.claude/settings.local.json

# --- Node / Next.js ---
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/versions
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts
.turbo/
.vercel/
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Service worker artifacts (Serwist — Phase 6)
public/sw.js
public/sw.js.map
public/swe-worker-*.js
public/workbox-*.js

# Playwright artifacts
test-results/
playwright-report/
blob-report/
playwright/.cache/

# --- Python / uv ---
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
.uv/
*.egg-info/
.eggs/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/

# --- Data, corpora and built artifacts (see notes/data-and-file-rules.md) ---
# Documents are data, not code: they live in Supabase Storage and are described
# by infra/corpus.yaml. If a command can regenerate it, it does not belong here.
data/
.cache/
tmp/
storage/
outputs/
*.faiss
*.index
*.pkl
*.npy
*.parquet
*.db
*.sqlite
*.sqlite3
# The one exception: the tiny, license-clean fixture corpus used by tests and CI.
!evals/fixtures/**

# --- Env files (commit only .env.example) ---
# `.env` alone does NOT match `legacy.env`, `prod.env`, `local.env` — a real
# secret leak got through on exactly that gap. `*.env` catches every variant.
.env
.env.*
*.env
!.env.example
!*.env.example

# --- OS / editor ---
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json
