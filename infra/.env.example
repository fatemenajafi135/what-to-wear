# Read by `supabase start` (infra/supabase/config.toml's `env(...)` substitutions).
# Copy to infra/.env and fill in only if you have a Google Cloud OAuth client — see
# docs/handoffs/003-auth.md §2. Leave blank to build/ship Google sign-in wired
# but untested locally; never commit real values here.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
