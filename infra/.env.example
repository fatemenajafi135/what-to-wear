# Read by `supabase start` (infra/supabase/config.toml's `env(...)` substitutions).
# Copy to infra/.env and fill in only if you have a Google Cloud OAuth client — see
# docs/handoffs/003-auth.md §2. Leave blank to build/ship Google sign-in wired
# but untested locally; never commit real values here.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Feature 012 (Calendar) reuses this same Google Cloud project's OAuth client, but its
# flow is app-orchestrated (never through Supabase Auth/GoTrue — see
# specs/012-calendar/research.md §1), so its client ID/secret belong in backend/.env
# (GOOGLE_OAUTH_CLIENT_ID/SECRET), not here. Nothing calendar-specific is read from
# this file or from config.toml.
